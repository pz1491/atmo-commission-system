// SI Ads Autopilot — data model
// Covers: multi-tenant orgs, Meta connections/entities, insights, automation
// rule engine + execution log, safety guardrails, budget history, alerts,
// audience discovery, reporting, audit log, and profit economics.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth.js / Auth.js) ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEDIA_BUYER
  ANALYST
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  hashedPassword String?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  memberships        Membership[]
  metaConnections    MetaConnection[]
  automationRules    AutomationRule[]
  automationActions  AutomationAction[]
  safetySettings     SafetySettings?
  alerts             Alert[]
  audienceSuggestions AudienceSuggestion[]
  reports            Report[]
  auditLogs          AuditLog[]
  products           Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(VIEWER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
}

// ─── Meta connection & ad hierarchy ────────────────────────────────────────

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

model MetaConnection {
  id             String           @id @default(cuid())
  organizationId String
  metaUserId     String
  accessToken    String           @db.Text
  tokenExpiresAt DateTime?
  scopes         String[]
  status         ConnectionStatus @default(CONNECTED)
  lastSyncedAt   DateTime?
  lastError      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccounts   AdAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, metaUserId])
}

enum SyncStatus {
  FRESH
  DELAYED
  ERROR
}

model AdAccount {
  id               String     @id @default(cuid())
  metaConnectionId String
  externalId       String     @unique // act_XXXXXXXX
  name             String
  currency         String     @default("THB")
  timezone         String     @default("Asia/Bangkok")
  status           String     @default("ACTIVE")
  pixelId          String?
  businessId       String?

  metaConnection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  budgetHistory  BudgetHistory[]
  products       Product[]

  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(FRESH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id            String   @id @default(cuid())
  adAccountId   String
  externalId    String   @unique
  name          String
  objective     String?
  status        String
  dailyBudget   Decimal? @db.Decimal(14, 2)
  lifetimeBudget Decimal? @db.Decimal(14, 2)
  budgetCap     Decimal? @db.Decimal(14, 2)
  metaCreatedAt DateTime?

  adAccount         AdAccount          @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adSets            AdSet[]
  insights          Insight[]
  automationActions AutomationAction[]
  budgetHistory     BudgetHistory[]

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdSet {
  id              String   @id @default(cuid())
  campaignId      String
  externalId      String   @unique
  name            String
  status          String
  dailyBudget     Decimal? @db.Decimal(14, 2)
  lifetimeBudget  Decimal? @db.Decimal(14, 2)
  optimizationGoal String?
  targeting       Json?

  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads               Ad[]
  insights          Insight[]
  automationActions AutomationAction[]
  budgetHistory     BudgetHistory[]

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ad {
  id         String   @id @default(cuid())
  adSetId    String
  externalId String   @unique
  name       String
  status     String

  adSet             AdSet              @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative          Creative?
  insights          Insight[]
  automationActions AutomationAction[]

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Creative {
  id           String  @id @default(cuid())
  adId         String  @unique
  externalId   String?
  thumbnailUrl String?
  headline     String?
  body         String? @db.Text
  hook         String?
  videoUrl     String?

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EntityType {
  ACCOUNT
  CAMPAIGN
  AD_SET
  AD
}

// Daily (and optionally hourly, via `hour`) performance snapshot for any
// entity level. One row per entity+date(+hour).
model Insight {
  id         String     @id @default(cuid())
  entityType EntityType
  // Denormalized copy of whichever of campaignId/adSetId/adId applies to
  // entityType, always non-null. Exists only so the compound unique index
  // below can be enforced — Prisma's compound-unique lookup type requires
  // every key field to be non-nullable, which the individual nullable FK
  // columns (kept for joins/includes) can't satisfy.
  entityId   String
  campaignId String?
  adSetId    String?
  adId       String?
  date       DateTime   @db.Date
  // -1 = daily rollup, 0-23 = a specific hour. Kept non-null for the same
  // compound-unique reason as entityId.
  hour       Int        @default(-1)

  spend             Decimal @default(0) @db.Decimal(14, 2)
  impressions       Int     @default(0)
  reach             Int     @default(0)
  clicks            Int     @default(0)
  linkClicks        Int     @default(0)
  landingPageViews  Int     @default(0)
  addToCart         Int     @default(0)
  initiateCheckout  Int     @default(0)
  purchases         Int     @default(0)
  purchaseValue     Decimal @default(0) @db.Decimal(14, 2)
  frequency         Decimal @default(0) @db.Decimal(6, 3)

  qualityRanking           String?
  engagementRateRanking    String?
  conversionRateRanking    String?

  syncedAt DateTime @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    AdSet?    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad       Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, date, hour])
  @@index([date])
}

// ─── Automation rule engine ────────────────────────────────────────────────

enum AutomationMode {
  OFF
  SIMULATION
  APPROVAL_REQUIRED
  AUTOPILOT
}

enum ActionType {
  PAUSE
  RESUME
  INCREASE_BUDGET_PERCENT
  DECREASE_BUDGET_PERCENT
  INCREASE_BUDGET_FIXED
  DECREASE_BUDGET_FIXED
  DUPLICATE
  SEND_ALERT
  ADD_TAG
}

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  priority       Int      @default(0)

  // Which entities this rule watches. null targetIds = all entities of targetType under the account.
  targetType EntityType @default(AD)
  targetIds  Json? // string[] of internal ids, null = all

  // Array of { metric, operator, value, value2? } combined with AND.
  conditions Json

  // { type: ActionType, percent?, amount?, tag?, duplicateMode? }
  action ActionType
  actionParams Json?

  cooldownHours   Int @default(6)
  maxTriggersPerDay Int @default(10)

  createdById String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      AutomationAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActionStatus {
  SIMULATED
  PENDING_APPROVAL
  EXECUTED
  BLOCKED
  FAILED
  IGNORED
}

model AutomationAction {
  id             String       @id @default(cuid())
  organizationId String
  ruleId         String?
  entityType     EntityType
  campaignId     String?
  adSetId        String?
  adId           String?

  actionType ActionType
  status     ActionStatus @default(PENDING_APPROVAL)

  reason       String  @db.Text
  ruleTriggered String?
  before       Json?
  after        Json?
  blockedReason String?

  // ruleId + entityId + time-bucket, enforced unique to prevent duplicate execution
  idempotencyKey String @unique

  executedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet        AdSet?          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad           Ad?             @relation(fields: [adId], references: [id], onDelete: Cascade)

  budgetHistory BudgetHistory[]
}

model BudgetHistory {
  id                 String   @id @default(cuid())
  adAccountId        String
  campaignId         String?
  adSetId            String?
  previousBudget     Decimal  @db.Decimal(14, 2)
  newBudget          Decimal  @db.Decimal(14, 2)
  changedBy          String   @default("AI") // "AI" | "USER:<userId>"
  automationActionId String?

  adAccount        AdAccount         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet            AdSet?            @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  automationAction AutomationAction? @relation(fields: [automationActionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// Guardrails + ROAS Guard + Scaling strategy — one row per organization.
model SafetySettings {
  id             String @id @default(cuid())
  organizationId String @unique

  automationMode AutomationMode @default(SIMULATION)

  maxAccountDailySpend      Decimal @default(100000) @db.Decimal(14, 2)
  maxCampaignDailyBudget    Decimal @default(30000) @db.Decimal(14, 2)
  maxIncreasePerActionPercent Int   @default(20)
  maxBudgetIncreasePer24hPercent Int @default(50)
  maxDuplicatesPerDay       Int     @default(3)
  maxAiActionsPerHour       Int     @default(20)
  budgetChangeCooldownHours Int     @default(6)

  killSwitchActive     Boolean @default(false)
  killSwitchPausesAds  Boolean @default(false)

  // ROAS Guard
  roasGuardTargetRoas     Decimal @default(3.0) @db.Decimal(6, 2)
  roasGuardBreakEvenRoas  Decimal @default(2.2) @db.Decimal(6, 2)
  roasGuardMinPurchases   Int     @default(3)
  roasGuardMinSpend       Decimal @default(1000) @db.Decimal(14, 2)
  targetCpa               Decimal? @db.Decimal(14, 2)

  // Smart Scaling
  scalingStrategy         String  @default("NORMAL") // CONSERVATIVE | NORMAL | AGGRESSIVE | CUSTOM
  scalingIncreasePercent  Int     @default(20)
  scalingMinPurchases     Int     @default(5)
  scalingMinSpend         Decimal @default(2000) @db.Decimal(14, 2)
  scalingMinActiveHours   Int     @default(12)

  dataFreshnessMaxMinutes Int @default(15)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Alerts ─────────────────────────────────────────────────────────────────

enum AlertType {
  ROAS_DROP
  SPEND_SPIKE
  NO_PURCHASE
  HIGH_CPA
  CREATIVE_FATIGUE
  BUDGET_NEAR_LIMIT
  META_API_ERROR
  TRACKING_ERROR
  PIXEL_DROP
  PURCHASE_DROP
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id             String        @id @default(cuid())
  organizationId String
  type           AlertType
  severity       AlertSeverity @default(WARNING)
  title          String
  message        String        @db.Text
  entityType     EntityType?
  entityId       String?
  channels       String[]      @default(["IN_APP"]) // IN_APP | EMAIL | LINE | WEBHOOK
  isRead         Boolean       @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Audience discovery ─────────────────────────────────────────────────────

model AudienceSuggestion {
  id                 String @id @default(cuid())
  organizationId     String
  productName        String
  productDescription String @db.Text
  targetCustomer     String?
  price              Decimal? @db.Decimal(14, 2)
  country            String   @default("TH")

  directInterests   Json // [{ name, available }]
  indirectInterests Json
  lifestyleInterests Json
  behaviorIntent    Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Reporting / audit ──────────────────────────────────────────────────────

model Report {
  id             String   @id @default(cuid())
  organizationId String
  type           String   @default("DAILY_SUMMARY")
  periodStart    DateTime
  periodEnd      DateTime
  data           Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILED
  BLOCKED
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorType      ActorType
  actorUserId    String?
  action         String
  entityType     EntityType?
  entityId       String?
  before         Json?
  after          Json?
  reason         String?     @db.Text
  ruleId         String?
  result         AuditResult @default(SUCCESS)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ─── Profit-based optimization ──────────────────────────────────────────────

model Product {
  id             String  @id @default(cuid())
  organizationId String
  adAccountId    String?
  name           String

  economics ProductEconomics?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductEconomics {
  id                String  @id @default(cuid())
  productId         String  @unique
  sellingPrice      Decimal @db.Decimal(14, 2)
  cogs              Decimal @db.Decimal(14, 2)
  shippingCost      Decimal @default(0) @db.Decimal(14, 2)
  platformFeePercent Decimal @default(0) @db.Decimal(6, 3)
  vatPercent        Decimal @default(7) @db.Decimal(6, 3)
  paymentFeePercent Decimal @default(0) @db.Decimal(6, 3)
  refundRatePercent Decimal @default(0) @db.Decimal(6, 3)
  otherCost         Decimal @default(0) @db.Decimal(14, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}
